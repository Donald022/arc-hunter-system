# Copy to .env. Never commit a filled .env.
NODE_ENV=development
APP_BASE_URL=http://127.0.0.1:8787
PORT=8787
LISTEN_HOST=127.0.0.1
LOG_LEVEL=info

# Postgres (Supabase session pooler, port 5432). Tests use DB_SCHEMA=arc_test.
DATABASE_URL=
DB_SCHEMA=arc
PG_POOL_MAX=4

# Notion — leave blank until inspect/diff is run against 03 — Anchor Tenant.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_COMPANIES_DATA_SOURCE_ID=
NOTION_CONTACTS_DATA_SOURCE_ID=
NOTION_ACTIVITY_DATA_SOURCE_ID=
NOTION_CAMPAIGNS_DATA_SOURCE_ID=
NOTION_FACTS_PAGE_ID=
NOTION_API_VERSION=2025-09-03

# Environment identity gate for every Notion write path (see NOTION_SCHEMA_AUDIT.md).
# staging is the safe default. Writes fail closed unless identity AND
# NOTION_WRITES_ENABLED both check out.
NOTION_ENVIRONMENT=staging
NOTION_WRITES_ENABLED=false
# Required when NOTION_ENVIRONMENT=staging. The page id of a Notion page titled with
# a "[STAGING]" marker that is NOT the production parent above. Get it after creating
# "[STAGING] ARC Hunter" in Notion and sharing it with the integration.
NOTION_EXPECTED_PARENT_PAGE_ID=

# Where loadFactsCached() reads the Approved Outreach Facts bundle from. "file" (the
# local/example JSON) is the only source that has been exercised end-to-end; "notion"
# is implemented and unit-tested but not yet verified against live data (Blocker 3).
FACTS_SOURCE=file

# Explicit application contract for the Notion Approved Outreach Facts database's
# record model — NEVER inferred from live data (the production database currently has
# zero rows, so its semantics can't be conclusively observed). Only "claim_per_row" is
# implemented: each row is one individual approved claim. Missing/unset or any other
# value fails closed when FACTS_SOURCE=notion. See NOTION_SCHEMA_AUDIT.md addendum.
NOTION_FACTS_RECORD_MODEL=claim_per_row

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
SLACK_APPROVER_IDS=
SLACK_REPLAY_WINDOW_SECONDS=300

# Gmail / Google Workspace
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER=

# Hosted LLM only. Never configure a local model URL.
LLM_PROVIDER=fixture
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
LLM_BILLING_TIER=
LLM_LIVE_ENABLED=false
DAILY_LLM_USD_CAP=0.20
DAILY_LLM_REQUEST_CAP=50
LLM_MAX_CONCURRENCY=1
LLM_RESERVED_INPUT_TOKENS=8000
LLM_RESERVED_OUTPUT_TOKENS=1500

# Optional last-mile enrichment after qualification only.
APOLLO_API_KEY=
APOLLO_ENABLED=false
DAILY_ENRICHMENT_CAP=10

# Jobs and outbound
INTERNAL_JOB_TOKEN=change-me-internal-job-token
DRY_RUN=true
LIVE_SEND_ENABLED=false
DAILY_SEND_CAP=5
DISCOVERY_PAUSED=false
OUTBOUND_PAUSED=false

# Dashboard. Fixture login is rejected when NODE_ENV=production.
DASHBOARD_SESSION_SECRET=change-me-dashboard-session-secret
DASHBOARD_OPERATOR_EMAILS=
DASHBOARD_FIXTURE_LOGIN=true
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Source fetch
SOURCE_USER_AGENT=ARC-Hunter-System/0.1 (+research; contact operator)
SOURCE_FETCH_TIMEOUT_MS=15000
SOURCE_MAX_CONCURRENCY=2
